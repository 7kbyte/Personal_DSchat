{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmitOnError": true,
    "outDir": "ui/static/js",
    "rootDir": "ts",
    "sourceMap": false,
    "removeComments": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["ts/**/*.ts"],
  "exclude": ["node_modules"]
}
